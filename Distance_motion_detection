#include <WiFi.h>
#include <HTTPClient.h>

// ---------- Pin definitions (adjust here if your wiring differs) ----------
#define PIR_PIN    13   // PIR "D" (OUT) pin
#define TRIG_PIN   5    // HC-SR04 TRIG
#define ECHO_PIN   18   // HC-SR04 ECHO

// ---------- WiFi (Wokwi simulated network) ----------
const char* ssid     = "Wokwi-GUEST";
const char* password = "";

// ---------- ThingSpeak ----------
// Create a channel with Field1 = Motion, Field2 = Distance (cm)
unsigned long channelID   = 3508545;              // <-- put your channel ID
const char*   writeAPIKey = "F3DT9A5XDAJY3N5X";  // <-- must be exactly 16 characters

long duration;
float distanceCm;
int motionState;

void setup() {
  Serial.begin(115200);

  pinMode(PIR_PIN, INPUT);
  pinMode(TRIG_PIN, OUTPUT);
  pinMode(ECHO_PIN, INPUT);
  digitalWrite(TRIG_PIN, LOW);

  Serial.print("Connecting to WiFi");
  WiFi.begin(ssid, password);
  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }
  Serial.println("\nWiFi Connected!");
}

float readDistanceCm() {
  // Send a 10us pulse to trigger the HC-SR04
  digitalWrite(TRIG_PIN, LOW);
  delayMicroseconds(2);
  digitalWrite(TRIG_PIN, HIGH);
  delayMicroseconds(10);
  digitalWrite(TRIG_PIN, LOW);

  // Read the echo pulse width (30ms timeout ~ safety cap)
  long duration = pulseIn(ECHO_PIN, HIGH, 30000);
  if (duration == 0) return -1; // no echo received

  // Speed of sound ~0.0343 cm/us, divide by 2 for round trip
  return (duration * 0.0343) / 2.0;
}

void loop() {
  motionState = digitalRead(PIR_PIN);
  distanceCm  = readDistanceCm();

  Serial.print("Motion: ");
  Serial.println(motionState == HIGH ? "DETECTED" : "clear");

  if (distanceCm < 0) {
    Serial.println("Distance: no echo (out of range)");
  } else {
    Serial.print("Distance: ");
    Serial.print(distanceCm);
    Serial.println(" cm");
  }

  // ---------- Upload to ThingSpeak ----------
  if (WiFi.status() == WL_CONNECTED) {
    HTTPClient http;

    String url = "http://api.thingspeak.com/update?api_key=";
    url += writeAPIKey;
    url += "&field1=";
    url += String(motionState);
    url += "&field2=";
    url += String(distanceCm);

    http.begin(url);
    int httpCode = http.GET();

    if (httpCode > 0) {
      String payload = http.getString();
      Serial.print("ThingSpeak Response: ");
      Serial.print(httpCode);
      Serial.print(" | Entry: ");
      Serial.println(payload);
    } else {
      Serial.println("ThingSpeak upload failed!");
    }

    http.end();
  }

  Serial.println("---");
  delay(16000); // stay above ThingSpeak's 15s free-tier limit
}
